# ── Coolify ──────────────────────────────────────────────────
# API token (Keys & Tokens → API tokens → "deploy" ability)
COOLIFY_TOKEN=your-api-token-here

# Full deploy endpoint with app UUID
# Example: https://app.coolify.io/api/v1/deploy?uuid=abc123
COOLIFY_WEBHOOK=https://your-coolify.com/api/v1/deploy?uuid=YOUR_APP_UUID

# ── GitHub ───────────────────────────────────────────────────
GITHUB_REPO=git@github.com:YOUR_USER/YOUR_REPO.git
GITHUB_BRANCH=main
