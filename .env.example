# ── Coolify ──────────────────────────────────────────────────
COOLIFY_TOKEN=your-api-token-here
COOLIFY_WEBHOOK=https://your-coolify.com/api/v1/deploy?uuid=YOUR_APP_UUID

# ── GitHub ───────────────────────────────────────────────────
GITHUB_REPO=git@github.com:YOUR_USER/YOUR_REPO.git
GITHUB_BRANCH=main

# ── n8n ──────────────────────────────────────────────────────
N8N_HOST=agentn8n.marcostorresalarcon.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://agentn8n.marcostorresalarcon.com/
N8N_ENCRYPTION_KEY=cambia-esto-por-un-string-aleatorio-seguro
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambia-esta-password
