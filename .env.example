# ═══════════════════════════════════════════════════════════
#  n8n + PostgreSQL — Variables de entorno
#  Copia este archivo a .env y completa los valores
# ═══════════════════════════════════════════════════════════

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=CAMBIA_ESTO_password_seguro
POSTGRES_DB=n8n

# Usuario no-root que usa n8n para conectarse (más seguro)
POSTGRES_NON_ROOT_USER=n8n_user
POSTGRES_NON_ROOT_PASSWORD=CAMBIA_ESTO_password_diferente

# ── n8n ──────────────────────────────────────────────────────
# Dominio donde está desplegado n8n (sin https://)
N8N_HOST=agentn8n.marcostorresalarcon.com

# Clave de cifrado para credenciales — genera con: openssl rand -hex 32
# IMPORTANTE: nunca cambies esto después del primer deploy o perderás las credenciales
N8N_ENCRYPTION_KEY=CAMBIA_ESTO_genera_con_openssl_rand_hex_32

# Zona horaria
GENERIC_TIMEZONE=America/Mexico_City

# ── Email / SMTP (opcional — para invitar usuarios) ──────────
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_PORT=465
N8N_SMTP_USER=tu@email.com
N8N_SMTP_PASS=tu_app_password
N8N_SMTP_SENDER=tu@email.com

# ── Coolify (para scripts locales) ───────────────────────────
COOLIFY_TOKEN=your-api-token-here
COOLIFY_WEBHOOK=https://coolify.marcostorresalarcon.com/api/v1/deploy?uuid=YOUR_APP_UUID

# ── GitHub ───────────────────────────────────────────────────
GITHUB_REPO=git@github.com:YOUR_USER/YOUR_REPO.git
GITHUB_BRANCH=main
